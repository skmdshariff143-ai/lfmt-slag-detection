# LFMT Research Platform - Backend Configuration Example
# Copy to .env and configure as appropriate for your local environment

# MATLAB Integration
LFMT_MATLAB_ENABLED=true
LFMT_MATLAB_MODE=engine
LFMT_MATLAB_EXECUTABLE=
LFMT_MATLAB_TIMEOUT_SECONDS=300

# API Server Configuration
LFMT_HOST=127.0.0.1
LFMT_PORT=8000
LFMT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging & Environment
LFMT_LOG_LEVEL=INFO
LFMT_ENV=development
