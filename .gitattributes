# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.json text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.m text eol=lf

# Explicit binary files
*.npz binary
*.npy binary
*.mat binary
*.h5 binary
*.hdf5 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.tar binary
*.gz binary
